{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/triaje",
      "dest": "/triaje_full.html"
    },
    {
      "src": "/facturacion",
      "dest": "/facturacion.html"
    },
    {
      "src": "/simulacion",
      "dest": "/simulacion.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "simulacion\\..*"
        }
      ],
      "src": "/(.*)",
      "dest": "/simulacion.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "facturacion\\..*"
        }
      ],
      "src": "/(.*)",
      "dest": "/facturacion.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
